# Copiar este archivo como .env.local y llenar con los datos de Firebase
# (Firebase → ⚙ Configuración del proyecto → General → Tus apps → app web → firebaseConfig)
VITE_FIREBASE_API_KEY=pegue-aqui-apiKey
VITE_FIREBASE_AUTH_DOMAIN=su-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=su-proyecto
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxx
